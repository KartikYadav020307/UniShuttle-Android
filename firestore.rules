rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──
    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isDriver()  { return isSignedIn() && userRole() == 'DRIVER'; }
    function isAdmin()   { return isSignedIn() && userRole() == 'ADMIN'; }
    function isStudent() { return isSignedIn() && userRole() == 'STUDENT'; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // ── users/{uid} ──
    // A signed-in user can read and create only their own document.
    // On create the role must be "student" — the client never writes any
    // other role. On update (owner or admin), the role field cannot change.
    match /users/{uid} {
      allow create: if isSignedIn() && isOwner(uid)
                    && request.resource.data.role == "student";
      allow read:   if isOwner(uid) || isAdmin();
      allow update: if (isOwner(uid) || isAdmin())
                    && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    // ── stops/{stopId} ──
    // All authenticated users can read stops (map and stop sheets).
    // Only admins can write.
    match /stops/{stopId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── seatAvailability/{shuttleId} ──
    // Students and drivers can read (seat meters).
    // Only the driver or admin can write (driver writes their own shuttle doc).
    match /seatAvailability/{shuttleId} {
      allow read:  if isSignedIn();
      allow write: if isDriver() || isAdmin();
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
